# One of several Tank Yard arenas on this machine: tankyard@ffa-1 reads
# /var/lib/tankyard/ffa-1.toml. Give each its own server_id, port, and ban,
# access and audit files. docs/hosting.md#scaling-arenas explains the setup.
[Unit]
Description=Tank Yard arena %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tankyard
Group=tankyard
StateDirectory=tankyard
WorkingDirectory=/var/lib/tankyard
ExecStart=/opt/tankyard/tankyard-server --config /var/lib/tankyard/%i.toml --no-console
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
